104-131-185-100.sslip.io {
    encode zstd gzip
    # Only well-formed app paths reach Node, including during a future redeploy.
    @app {
        path /ws /rooms /pot /pot/claim /pot/cancel /lnurlw /lnurlw/cb /health
        expression "!{http.request.orig_uri}.startsWith(\"//\")"
    }
    handle @app {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle {
        respond 404
    }
}
