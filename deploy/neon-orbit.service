[Unit]
Description=Neon Orbit game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neonorbit
Group=neonorbit
WorkingDirectory=/opt/neon-orbit
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=POT_ENABLED=0
EnvironmentFile=-/etc/neon-orbit/pot.env
StateDirectory=neon-orbit
StateDirectoryMode=0700
ReadWritePaths=/var/lib/neon-orbit
ExecStart=/usr/bin/node /opt/neon-orbit/dist-server/listener.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
