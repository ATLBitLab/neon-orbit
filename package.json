{
  "name": "neon-orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A low-poly neon space fighter dogfight in orbit around a lush green world.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:sim": "esbuild scripts/simcheck.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/simcheck.mjs --log-level=warning && node node_modules/.cache/simcheck.mjs",
    "check:balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/balance.mjs --log-level=warning && node node_modules/.cache/balance.mjs",
    "check:mutants": "node scripts/mutate.mjs",
    "check": "npm run typecheck && npm run check:sim && npm run check:balance"
  },
  "dependencies": {
    "nostr-tools": "^2.25.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
