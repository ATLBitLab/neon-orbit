{
  "name": "neon-orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A low-poly neon space fighter dogfight in orbit around a lush green world.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:sim": "esbuild scripts/simcheck.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/simcheck.mjs --log-level=warning && node node_modules/.cache/simcheck.mjs",
    "check": "npm run typecheck && npm run check:sim"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.180.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
