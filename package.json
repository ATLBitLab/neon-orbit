{
  "name": "neon-orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A low-poly neon space fighter dogfight in orbit around a lush green world.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:sim": "esbuild scripts/simcheck.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/simcheck.mjs --log-level=warning && node node_modules/.cache/simcheck.mjs",
    "check:balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/balance.mjs --log-level=warning && node node_modules/.cache/balance.mjs",
    "check:mutants": "node scripts/mutate.mjs",
    "check": "npm run typecheck && npm run check:sim && npm run check:balance",
    "bench:server": "esbuild scripts/server-bench.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/server-bench.mjs --log-level=warning && node node_modules/.cache/server-bench.mjs",
    "check:bandwidth": "npm run bench:server -- 60 4 --enforce-budget",
    "build:server": "esbuild src/server/listener.ts --bundle --packages=external --platform=node --format=esm --target=node20 --outfile=dist-server/listener.mjs --log-level=warning",
    "start:server": "node dist-server/listener.mjs",
    "check:server": "node scripts/server-smoke.mjs",
    "check:server-isolation": "node scripts/server-isolation.mjs",
    "check:server-resume": "esbuild scripts/server-resume.ts --bundle --packages=external --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/server-resume.mjs --log-level=warning && node node_modules/.cache/server-resume.mjs",
    "check:pot": "npm run build:server && esbuild scripts/pot-check.ts --bundle --packages=external --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/pot-check.mjs --log-level=warning && node node_modules/.cache/pot-check.mjs && node scripts/pot-server-smoke.mjs"
  },
  "dependencies": {
    "nostr-tools": "^2.25.2",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
